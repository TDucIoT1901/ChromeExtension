{
  "manifest_version": 3,
  "name": "Pocket Notes",
  "version": "1.0.0",
  "description": "Ghi chú nhanh và lưu trữ liên kết tab hiện tại trên trình duyệt.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}